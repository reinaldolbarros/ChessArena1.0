<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChessMAUI.Views.CareerFlowPage"
             Title="Como Funciona a Carreira"
             BackgroundColor="#0A1020">

    <ScrollView>
        <VerticalStackLayout Padding="24,28,24,40" Spacing="24">

            <!-- Intro — mesmo estilo da tela de boas-vindas do modo carreira -->
            <Label Text="🏆" FontSize="44" HorizontalTextAlignment="Center"/>
            <VerticalStackLayout Spacing="4">
                <Label Text="Circuito FIDE"
                       TextColor="White" FontSize="22" FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>
                <Label Text="7 fases, cada uma mais forte que a anterior. Avance vencendo, ou tente de novo."
                       TextColor="#9FB3C8" FontSize="14" HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>

            <!-- Trilha — lista minimalista, sem cartões pesados -->
            <VerticalStackLayout Spacing="0">

                <VerticalStackLayout Spacing="2" Padding="0,12">
                    <Label TextColor="#F2F5F8" FontSize="16" FontAttributes="Bold">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="♟  " TextColor="#3E6FA8"/>
                                <Span Text="Torneio Local"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="Suíço · 5 rodadas · Fácil → Médio · Top 2 avançam ao Zonal"
                           TextColor="#8A9AAA" FontSize="13"/>
                </VerticalStackLayout>
                <BoxView HeightRequest="1" BackgroundColor="#1A2535"/>

                <VerticalStackLayout Spacing="2" Padding="0,12">
                    <Label TextColor="#F2F5F8" FontSize="16" FontAttributes="Bold">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="♞  " TextColor="#4F7FBB"/>
                                <Span Text="Torneio Zonal"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="Suíço · 5 rodadas · Fácil → Médio · Top 2 avançam à Copa do Mundo"
                           TextColor="#8A9AAA" FontSize="13"/>
                    <Label Text="Duas falhas seguidas aqui e você volta ao Local."
                           TextColor="#6A7A8A" FontSize="12" FontAttributes="Italic"/>
                </VerticalStackLayout>
                <BoxView HeightRequest="1" BackgroundColor="#1A2535"/>

                <VerticalStackLayout Spacing="2" Padding="0,12">
                    <Label TextColor="#F2F5F8" FontSize="16" FontAttributes="Bold">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="♝  " TextColor="#6C7FA0"/>
                                <Span Text="Copa do Mundo FIDE"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="Eliminação direta · melhor de 2 · Médio → Difícil"
                           TextColor="#8A9AAA" FontSize="13"/>
                    <Label Text="Vencer tudo classifica direto aos Candidatos. Uma queda manda pro Grand Swiss."
                           TextColor="#6A7A8A" FontSize="12" FontAttributes="Italic"/>
                </VerticalStackLayout>
                <BoxView HeightRequest="1" BackgroundColor="#1A2535"/>

                <VerticalStackLayout Spacing="2" Padding="0,12">
                    <Label TextColor="#F2F5F8" FontSize="16" FontAttributes="Bold">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="♜  " TextColor="#8A83A8"/>
                                <Span Text="Grand Swiss / Grand Prix"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="Suíço · 5 rodadas · Médio → Difícil · Segunda chance rumo aos Candidatos"
                           TextColor="#8A9AAA" FontSize="13"/>
                </VerticalStackLayout>
                <BoxView HeightRequest="1" BackgroundColor="#1A2535"/>

                <VerticalStackLayout Spacing="2" Padding="0,12">
                    <Label TextColor="#F2F5F8" FontSize="16" FontAttributes="Bold">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="♛  " TextColor="#AB8A38"/>
                                <Span Text="Torneio de Candidatos"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="Round-robin · 6 jogadores de elite · Difícil · Só o 1º avança"
                           TextColor="#8A9AAA" FontSize="13"/>
                </VerticalStackLayout>
                <BoxView HeightRequest="1" BackgroundColor="#1A2535"/>

                <VerticalStackLayout Spacing="2" Padding="0,12">
                    <Label TextColor="#FFD700" FontSize="16" FontAttributes="Bold">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="👑  "/>
                                <Span Text="Campeonato Mundial"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="Melhor de 5 vitórias · Hard, força máxima"
                           TextColor="#8A9AAA" FontSize="13"/>
                    <Label Text="Quem fizer 3 vitórias primeiro leva o título."
                           TextColor="#6A7A8A" FontSize="12" FontAttributes="Italic"/>
                </VerticalStackLayout>

            </VerticalStackLayout>

            <Label Text="Cada fase tem um caminho de volta — persistência é a chave."
                   TextColor="#5A7A9A" FontSize="12" HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
