<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChessMAUI.Views.CareerPage"
             Title="Modo Carreira"
             BackgroundColor="#001B26">

    <!-- Raiz: scroll ocupa tudo, botões fixados no rodapé -->
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="18,16,18,8" Spacing="14">

                <!-- ══ Cabeçalho: nome do torneio + botão fluxo ══ -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                    <Label x:Name="TournamentNameLabel" Text="Modo Carreira"
                           TextColor="#F2F5F8" FontSize="24" FontAttributes="Bold"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="1"
                            Text="⬡"
                            Clicked="OnShowFlowClicked"
                            BackgroundColor="#0D2A4A" TextColor="#4AA3FF"
                            FontSize="18" CornerRadius="10"
                            HeightRequest="38" WidthRequest="38"
                            Padding="0" VerticalOptions="Center"/>
                </Grid>

                <!-- ══ Card de contexto: nível + progresso ══ -->
                <Border BackgroundColor="#071F3C" Stroke="#2E7DDB" StrokeThickness="1.4"
                        StrokeShape="RoundRectangle 16" Padding="16,14">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="LevelLabel" Text=""
                                   TextColor="#A56CFF" FontSize="14" FontAttributes="Bold"/>
                            <Label x:Name="RoundInfoLabel" Grid.Column="1"
                                   Text="" TextColor="#9FB3C8" FontSize="13"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <ProgressBar x:Name="RoundProgressBar"
                                     Progress="0" ProgressColor="#2E7DDB"
                                     BackgroundColor="#0D2A4A"/>
                        <Label x:Name="LevelSubLabel" Text=""
                               TextColor="#9FB3C8" FontSize="13"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ══ Welcome (carreira não iniciada) ══ -->
                <VerticalStackLayout x:Name="WelcomeSection" IsVisible="False" Spacing="16">
                    <Label Text="Suba da base até o topo. Passe por 7 níveis do circuito FIDE e torne-se Campeão Mundial."
                           TextColor="#9FB3C8" FontSize="15" HorizontalTextAlignment="Center"/>
                    <Button Text="Iniciar Carreira"
                            Clicked="OnStartCareerClicked"
                            BackgroundColor="#1F6B36" TextColor="White"
                            FontAttributes="Bold" FontSize="17"
                            CornerRadius="14" HeightRequest="52"/>
                </VerticalStackLayout>

                <!-- ══ Classificação Swiss ══ -->
                <Border x:Name="StandingsSection" IsVisible="False"
                        BackgroundColor="#061F33" Stroke="#1E3A5A" StrokeThickness="1.1"
                        StrokeShape="RoundRectangle 16" Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="16,12,16,10">
                            <Label Text="Classificação"
                                   TextColor="#F2F5F8" FontSize="14" FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                            <Border Grid.Column="1"
                                    BackgroundColor="#0A2A14" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" Padding="10,4">
                                <Label x:Name="ZoneLabel" Text=""
                                       TextColor="#4CAF50" FontSize="12" FontAttributes="Bold"/>
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#1E3A5A" Margin="0,0,0,0"/>
                        <VerticalStackLayout x:Name="StandingsList" Spacing="0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ══ Copa do Mundo – bracket ══ -->
                <Border x:Name="CopaSection" IsVisible="False"
                        BackgroundColor="#061F33" Stroke="#1E3A5A" StrokeThickness="1.1"
                        StrokeShape="RoundRectangle 16" Padding="0">
                    <VerticalStackLayout>
                        <Label Text="Copa do Mundo FIDE — Eliminação Direta"
                               TextColor="#F2F5F8" FontSize="14" FontAttributes="Bold"
                               Padding="16,12,16,10"/>
                        <BoxView HeightRequest="1" BackgroundColor="#1E3A5A"/>
                        <VerticalStackLayout x:Name="CopaBracket" Spacing="0" Padding="0,4,0,4"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ══ Mundial – score ══ -->
                <Border x:Name="MundialSection" IsVisible="False"
                        BackgroundColor="#071F3C" Stroke="#FFD447" StrokeThickness="1.4"
                        StrokeShape="RoundRectangle 16" Padding="16,20">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Campeonato Mundial de Xadrez"
                               TextColor="#9FB3C8" FontSize="13" FontAttributes="Bold"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="MundialScoreLabel" Text="0 × 0"
                               TextColor="#F2F5F8" FontSize="40" FontAttributes="Bold"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="MundialSubLabel" Text=""
                               TextColor="#9FB3C8" FontSize="13"
                               HorizontalTextAlignment="Center"/>
                        <BoxView HeightRequest="1" BackgroundColor="#1E3A5A" Margin="0,4,0,4"/>
                        <VerticalStackLayout x:Name="MundialHistory" Spacing="4"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ══ Próximo adversário ══ -->
                <Border x:Name="OpponentSection" IsVisible="False"
                        BackgroundColor="#071F3C" Stroke="#2E7DDB" StrokeThickness="1.4"
                        StrokeShape="RoundRectangle 16" Padding="16,14">
                    <Grid ColumnDefinitions="52,*,Auto">
                        <Border x:Name="OppAvatarBorder"
                                WidthRequest="44" HeightRequest="44"
                                BackgroundColor="#0D2A4A" StrokeThickness="0"
                                StrokeShape="RoundRectangle 22"
                                VerticalOptions="Center">
                            <Label x:Name="OppAvatarLabel" Text="♞" FontSize="24"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2"
                                            VerticalOptions="Center" Margin="4,0,0,0">
                            <Label x:Name="OpponentContextLabel" Text="Próximo adversário"
                                   TextColor="#9FB3C8" FontSize="12"/>
                            <Label x:Name="OpponentNameLabel" Text=""
                                   TextColor="#F2F5F8" FontSize="17" FontAttributes="Bold"/>
                            <Label x:Name="OpponentRatingLabel" Text=""
                                   TextColor="#9FB3C8" FontSize="12"/>
                        </VerticalStackLayout>
                        <Border x:Name="OppDiffBadge" Grid.Column="2"
                                BackgroundColor="#1A2A4A" StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,6" VerticalOptions="Center">
                            <Label x:Name="OpponentDiffLabel" Text=""
                                   TextColor="#9AB8D8" FontSize="13" FontAttributes="Bold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ══ Resultado da fase ══ -->
                <Border x:Name="ResultSection" IsVisible="False"
                        BackgroundColor="#061F33" Stroke="#1E3A5A" StrokeThickness="1.1"
                        StrokeShape="RoundRectangle 16" Padding="20,20">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label x:Name="ResultIcon" Text="" FontSize="36"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="ResultTitle" Text=""
                               TextColor="#F2F5F8" FontSize="18" FontAttributes="Bold"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="ResultDetail" Text=""
                               TextColor="#9FB3C8" FontSize="14"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="ResultDestination" Text=""
                               TextColor="#4AA3FF" FontSize="14" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══ Rodapé fixo: botões de ação ══ -->
        <VerticalStackLayout Grid.Row="1" Padding="18,10,18,28" Spacing="10"
                             BackgroundColor="#001B26">
            <Button x:Name="PlayBtn" Text="Jogar"
                    IsVisible="False"
                    Clicked="OnPlayRoundClicked"
                    BackgroundColor="#1F6B36" TextColor="White"
                    FontAttributes="Bold" FontSize="17"
                    CornerRadius="14" HeightRequest="54"/>
            <Button x:Name="NextBtn" Text=""
                    IsVisible="False"
                    Clicked="OnNextActionClicked"
                    BackgroundColor="#2A67B1" TextColor="White"
                    FontAttributes="Bold" FontSize="16"
                    CornerRadius="14" HeightRequest="50"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
